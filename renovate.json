{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Self-contained copy of the maintainer's dependency lanes, so this public repository reads no private preset.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 7am on monday"],
  "prConcurrentLimit": 5,
  "labels": ["deps"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["deps", "security"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 7am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Auto-merge after green CI: non-major dev dependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "dev dependencies (non-major)",
      "automerge": true
    },
    {
      "description": "Auto-merge after green CI: GitHub Actions, pinned by digest",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "groupName": "github actions",
      "automerge": true
    },
    {
      "description": "Review: non-major runtime dependencies, grouped weekly",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "runtime dependencies (non-major)",
      "automerge": false
    },
    {
      "description": "Deliberate: every major waits for approval on the dependency dashboard",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "labels": ["deps", "major"]
    }
  ]
}
