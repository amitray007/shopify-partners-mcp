# The number in your Partner Dashboard URL (not the Dev Dashboard organization ID).
SHOPIFY_PARTNER_ID=
# Partner API client token: Dev Dashboard > Organization settings > Users > Security.
SHOPIFY_PARTNER_ACCESS_TOKEN=
# Optional. Comma-separated app IDs for list_apps.
SHOPIFY_PARTNER_APP_IDS=
# Optional. Defaults to 2026-07.
SHOPIFY_PARTNER_API_VERSION=
