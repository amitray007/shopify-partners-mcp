{
  "name": "shopify-partners-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for the Shopify Partner API: apps, earnings, install and billing events, subscriptions.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "partner-api",
    "shopify",
    "shopify-partners"
  ],
  "homepage": "https://github.com/amitray007/shopify-partners-mcp#readme",
  "bugs": {
    "url": "https://github.com/amitray007/shopify-partners-mcp/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitray007/shopify-partners-mcp.git"
  },
  "bin": {
    "shopify-partners-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "test": "vitest run",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
    "fix": "ultracite fix",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "graphql": "^17.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "knip": "^6.46.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "ultracite": "8.3.1",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
